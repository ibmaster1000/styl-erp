+					}
+				} else {
+					alert('저장에 실패했습니다.');
+				}
+			} catch (e) {
+				console.error(e);
+				alert('저장 중 오류가 발생했습니다.');
+			}
+		}
+
+		function openCodePopup(type, key, fieldPrefix) {
+			currentCodeTarget = { key, fieldPrefix };
