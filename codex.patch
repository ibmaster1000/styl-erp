+		}
+
+		async function handleSearch() {
+			const styleNo = styleNoInput.value.trim();
+			if (!styleNo) {
+				alert('품번을 입력하세요.');
+				return;
+			}
+			currentStyle = styleNo;
+			try {
+				setFilterDisabled(true);
+				await loadFilters(styleNo);
+				await loadAgreements(styleNo);
+				await loadDetail(styleNo);
