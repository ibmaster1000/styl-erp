+				console.error(e);
+				alert('검색 중 문제가 발생했습니다.');
+			}
+		}
+
+		async function handleDispatch(button) {
+			const row = button.closest('tr');
+			const payload = {
+				styleNo: row.dataset.styleNo,
+				agreementCode: row.dataset.agreementCode,
+				color: row.dataset.color,
+				empNo: empNoInput.value.trim(),
+				empName: empNameInput.value.trim()
+			};
+			if (!payload.styleNo) {
+				alert('품번 정보가 없습니다.');
+				return;
+			}
+			if (!confirm('작업을 지시하시겠습니까?')) {
+				return;
+			}
+			try {
+				const response = await fetchJson('/api/work-orders/dispatch', {
+					method: 'POST',
+					body: JSON.stringify(payload)
+				});
+				if (response.success) {
+					button.disabled = true;
+					button.textContent = '지시 완료';
+					row.classList.add('wo-row-disabled');
+				} else if (response.message) {
+					alert(response.message);
+				}
+			} catch (e) {
+				console.error(e);
+				alert('작업지시 생성에 실패했습니다.');
+			}
+		}
+
+		function captureDetailChange(key, patch) {
+			const base = originalDetails.get(key) || {};
+			const existing = changedDetails.get(key) || {};
+			const merged = { ...base, ...existing, ...patch };
+
+			const isSame = ['factoryCode', 'factoryName', 'deliveryPlaceCode', 'deliveryPlaceName', 'dueDate']
+				.every(field => (base[field] || '') === (merged[field] || ''));
+
+			if (isSame) {
+				changedDetails.delete(key);
+			} else {
+				changedDetails.set(key, merged);
+			}
+		}
+
+		function updateRowValues(row, key) {
+			const current = changedDetails.get(key) || originalDetails.get(key) || {};
+			row.querySelector('[data-field="factoryName"]').value = current.factoryName || '';
+			row.querySelector('[data-field="factoryCode"]').value = current.factoryCode || '';
+			row.querySelector('[data-field="deliveryPlaceName"]').value = current.deliveryPlaceName || '';
+			row.querySelector('[data-field="deliveryPlaceCode"]').value = current.deliveryPlaceCode || '';
+			row.querySelector('[data-field="dueDate"]').value = current.dueDate || '';
+		}
+
